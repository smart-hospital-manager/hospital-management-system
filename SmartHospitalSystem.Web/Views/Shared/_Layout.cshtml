<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - مستشفى Smart Hospital</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SmartHospitalSystem.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        @using Microsoft.AspNetCore.Identity
        @inject SignInManager<IdentityUser> SignInManager
        @inject UserManager<IdentityUser> UserManager

        <div class="sh-topbar d-none d-md-block">
            <div class="container-fluid py-1">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex gap-4">
                        <span class="sh-topbar-item"><i class="bi bi-telephone-fill"></i> خط الطوارئ: 16999</span>
                        <span class="sh-topbar-item"><i class="bi bi-clock-fill"></i> متاح على مدار الساعة 24/7</span>
                        <span class="sh-topbar-item"><i class="bi bi-geo-alt-fill"></i> القاهرة، مصر</span>
                    </div>
                    <div class="d-flex gap-3">
                        <a href="#"><i class="bi bi-facebook"></i></a>
                        <a href="#"><i class="bi bi-twitter-x"></i></a>
                        <a href="#"><i class="bi bi-instagram"></i></a>
                        <a href="#"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>
            </div>
        </div>

        <nav class="navbar navbar-expand-lg sh-navbar sticky-top">
            <div class="container-fluid px-3 px-lg-4">
                <a class="sh-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="sh-brand-icon"><i class="bi bi-hospital"></i></span>
                    <span>
                        Smart Hospital
                        <small>نظام إدارة المستشفى الذكي</small>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 pe-0 mx-lg-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door-fill"></i> الرئيسية</a>
                        </li>

                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Department" asp-action="Index"><i class="bi bi-building"></i> الأقسام الطبية</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Doctor" asp-action="Index"><i class="bi bi-heart-pulse-fill"></i> الأطباء</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Patient" asp-action="Index"><i class="bi bi-people-fill"></i> المرضى</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Appointment" asp-action="Index"><i class="bi bi-calendar-check-fill"></i> المواعيد</a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto ps-0 align-items-lg-center gap-2">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <span class="sh-user-chip">
                                    <span class="sh-user-avatar"><i class="bi bi-person-fill"></i></span>
                                    أهلاً، @UserManager.GetUserName(User)
                                </span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link sh-logout-link" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-left"></i> تسجيل الخروج</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link sh-btn-ghost" asp-controller="Account" asp-action="Login">تسجيل الدخول</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link sh-btn-solid" asp-controller="Account" asp-action="Register">إنشاء حساب</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-0">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="sh-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="sh-brand mb-3" style="color:#fff !important;">
                        <span class="sh-brand-icon"><i class="bi bi-hospital"></i></span>
                        <span style="color:#fff;">Smart Hospital</span>
                    </div>
                    <p class="small">منظومة رقمية متكاملة لإدارة المستشفيات، تجمع بين الرعاية الطبية والتكنولوجيا الذكية لخدمة أفضل للمرضى والطاقم الطبي.</p>
                    <div class="mt-3">
                        <a href="#" class="sh-social"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="sh-social"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="sh-social"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="sh-social"><i class="bi bi-youtube"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h6>روابط سريعة</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 small">
                        <li><a asp-controller="Home" asp-action="Index"><i class="bi bi-chevron-left"></i> الرئيسية</a></li>
                        <li><a asp-controller="Department" asp-action="Index"><i class="bi bi-chevron-left"></i> الأقسام</a></li>
                        <li><a asp-controller="Doctor" asp-action="Index"><i class="bi bi-chevron-left"></i> الأطباء</a></li>
                        <li><a asp-controller="Appointment" asp-action="Index"><i class="bi bi-chevron-left"></i> المواعيد</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6>تواصل معنا</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 small">
                        <li><i class="bi bi-telephone-fill me-1"></i> 16999</li>
                        <li><i class="bi bi-envelope-fill me-1"></i> info@smarthospital.com</li>
                        <li><i class="bi bi-geo-alt-fill me-1"></i> القاهرة، مصر</li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6>ساعات العمل</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 small">
                        <li>الطوارئ: على مدار الساعة</li>
                        <li>العيادات الخارجية: 9 ص - 9 م</li>
                        <li>السبت - الخميس</li>
                    </ul>
                </div>
            </div>
            <div class="sh-footer-bottom text-center">
                &copy; 2026 Smart Hospital System — جميع الحقوق محفوظة | <a asp-area="" asp-controller="Home" asp-action="Privacy">سياسة الخصوصية</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
