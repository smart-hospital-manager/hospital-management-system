@model ErrorViewModel
@{
    ViewData["Title"] = "حدث خطأ";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-7 text-center">
            <div class="sh-page-icon mx-auto mb-3" style="width:80px;height:80px;font-size:2.4rem; background:rgba(224,67,91,0.12); color:var(--sh-danger);">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <h2 class="fw-bold">عذراً، حدث خطأ غير متوقع</h2>
            <p class="text-muted">نعتذر عن هذا الإزعاج، يرجى المحاولة مرة أخرى أو العودة للصفحة الرئيسية.</p>

            @if (Model != null && Model.ShowRequestId)
            {
                <p class="small text-muted">
                    <strong>رقم الطلب:</strong> <code>@Model.RequestId</code>
                </p>
            }

            <a asp-controller="Home" asp-action="Index" class="btn sh-btn-solid px-4 py-2 mt-3">
                <i class="bi bi-house-door-fill me-1"></i> العودة للصفحة الرئيسية
            </a>
        </div>
    </div>
</div>
