@model List<SmartHospitalSystem.Service.ViewModels.AppointmentViewModel>

@{
    ViewData["Title"] = "مواعيد الدكتور";
}

<div class="container mt-2" dir="rtl">
    <div class="page-header-box mb-4 border-start border-warning border-4 bg-white p-4 rounded-4 shadow-sm">
        <h3 class="text-dark fw-bold mb-1">📅 مواعيد الحجوزات الخاصة بـ: د. @ViewBag.DoctorName</h3>
        <p class="text-muted mb-0 small">كشف تفصيلي بجدول الحالات المحجوزة للعيادة حالياً</p>
    </div>

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var app in Model)
            {
                <div class="col-lg-6">
                    <!-- ستايل التذكرة اللي عملناه للمواعيد -->
                    <div class="card shadow-sm h-100 border-0 rounded-4 p-3 bg-white">
                        <div class="card-body">
                            <span class="text-muted small fw-bold">كود الحجز: #@app.Id</span>
                            <h5 class="fw-bold text-primary mt-2"><i class="bi bi-person-fill"></i> المريض: @app.PatientFullName</h5>
                            <p class="text-danger fw-bold my-2"><i class="bi bi-clock"></i> التوقيت: @app.AppointmentDate.ToString("yyyy-MM-dd hh:mm tt")</p>
                            <p class="text-muted small bg-light p-2 rounded"><i class="bi bi-chat-left-text"></i> الشكوى: @app.ReasonForVisit</p>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5 bg-white rounded-4 shadow-sm">
                <i class="bi bi-calendar-x display-3 text-muted"></i>
                <h5 class="fw-bold text-secondary mt-3">لا توجد مواعيد محجوزة لهذا الطبيب حالياً</h5>
            </div>
        }
    </div>
    <div class="mt-4">
        <a asp-action="Index" class="btn btn-light border fw-bold">رجوع للأطباء</a>
    </div>
</div>