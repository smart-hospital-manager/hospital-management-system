@model List<SmartHospitalSystem.Service.ViewModels.DoctorViewModel>

@{
    ViewData["Title"] = "الأطباء المعالجون";
}

<style>
    .doctor-card {
        border: none;
        border-radius: 20px;
        background: #ffffff;
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        position: relative;
        overflow: hidden;
    }

        .doctor-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(26, 54, 93, 0.08) !important;
        }

    .doctor-badge-dept {
        position: absolute;
        top: 15px;
        left: 15px;
        background: rgba(79, 209, 197, 0.15);
        color: #2c7a7b;
        font-weight: 700;
        padding: 0.4rem 1rem;
        border-radius: 50px;
        font-size: 0.8rem;
    }

    .edit-doctor-btn {
        position: absolute;
        top: 15px;
        right: 15px;
        background: #fff;
        color: #4a5568;
        border-radius: 50%;
        width: 35px;
        height: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        transition: all 0.2s;
    }

        .edit-doctor-btn:hover {
            background: #e2e8f0;
            color: #1a365d;
        }

    .doctor-avatar-wrapper {
        width: 110px;
        height: 110px;
        margin: 0 auto;
        position: relative;
    }

    .doctor-avatar-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 24px;
        border: 4px solid #f7fafc;
        box-shadow: 0 8px 20px rgba(0,0,0,0.05);
    }

    .doctor-status-dot {
        width: 14px;
        height: 14px;
        background: #48bb78;
        border: 3px solid #ffffff;
        border-radius: 50%;
        position: absolute;
        bottom: 5px;
        right: 5px;
    }
</style>

<div class="container mt-2" dir="rtl">
    <div class="page-header-box d-flex justify-content-between align-items-center mb-5 border-start border-info border-4 bg-white p-4 rounded-4 shadow-sm">
        <div>
            <h3 class="text-dark fw-bold mb-1"><i class="bi bi-person-workspace text-info me-2"></i> الطاقم الطبي والاستشاريين</h3>
            <p class="text-muted mb-0 small">تصفح وفلترة ملفات الأطباء النشطين بالمنظومة</p>
        </div>
        <a asp-action="Create" class="btn btn-info fw-bold text-dark px-4 py-2 rounded-3 shadow-sm"><i class="bi bi-person-plus-fill me-1"></i> إضافة طبيب للمنظومة</a>
    </div>

    <div class="row g-4">
        @if (Model != null)
        {
            foreach (var doc in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6">
                    <div class="card doctor-card h-100 shadow-sm p-4 text-center">
                        <a asp-action="Edit" asp-route-id="@doc.Id" class="edit-doctor-btn" title="تعديل البيانات"><i class="bi bi-pencil-square"></i></a>
                        <span class="doctor-badge-dept shadow-sm"><i class="bi bi-building me-1"></i> @doc.DepartmentName</span>

                        <div class="doctor-avatar-wrapper mb-3 mt-2">
                            <img src="@(string.IsNullOrEmpty(doc.Biography) || !doc.Biography.StartsWith("/uploads/") ? "https://images.unsplash.com/photo-1622253692010-333f2da6031d?auto=format&fit=crop&w=150&q=80" : doc.Biography)" class="doctor-avatar-img" alt="Doctor Profile" />
                            <div class="doctor-status-dot"></div>
                        </div>

                        <h5 class="fw-bold text-dark mb-1">د. @doc.FirstName @doc.LastName</h5>
                        <p class="text-primary fw-600 small mb-3">@doc.Specialization</p>

                        <div class="text-start bg-light p-3 rounded-3 mb-3 small">
                            <div class="d-flex justify-content-between mb-1"><span class="text-muted">الهاتف:</span><span class="text-dark fw-bold">@doc.PhoneNumber</span></div>
                            <div class="d-flex justify-content-between"><span class="text-muted">القومي:</span><span class="font-monospace text-secondary">@doc.NationalId</span></div>
                        </div>

                        <div class="mt-auto">
                            <a class="btn btn-outline-info w-100 fw-bold rounded-3 py-2 btn-sm" asp-action="Appointments" asp-route-id="@doc.Id"><i class="bi bi-calendar-event me-1"></i> عرض المواعيد</a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>