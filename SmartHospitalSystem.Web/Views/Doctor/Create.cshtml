@model SmartHospitalSystem.Service.ViewModels.DoctorCreateViewModel

@{
    ViewData["Title"] = "إضافة طبيب";
}

<div class="container mt-4" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow border-0 rounded-4">
                <div class="card-body p-5">
                    <div class="text-center mb-5">
                        <div class="bg-info bg-opacity-10 text-info d-inline-flex align-items-center justify-content-center rounded-circle p-3 mb-3 shadow-sm">
                            <i class="bi bi-person-badge fs-1"></i>
                        </div>
                        <h3 class="fw-bold text-dark">ملف حصر طبيب جديد</h3>
                        <p class="text-muted">قم بتعبئة البيانات لربط الطبيب بالمنظومة</p>
                    </div>

                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label fw-bold text-secondary">الاسم الأول</label>
                                <input asp-for="FirstName" class="form-control form-control-lg border-2" required />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label fw-bold text-secondary">الاسم الأخير</label>
                                <input asp-for="LastName" class="form-control form-control-lg border-2" required />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Specialization" class="form-label fw-bold text-secondary">التخصص الطبي</label>
                                <input asp-for="Specialization" class="form-control form-control-lg border-2" required />
                                <span asp-validation-for="Specialization" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DepartmentId" class="form-label fw-bold text-secondary">القسم الطبي التابع له</label>
                                <select asp-for="DepartmentId" class="form-select form-select-lg border-2 fw-bold text-info" asp-items="ViewBag.Departments" required>
                                    <option value="">-- حدد تخصص القسم --</option>
                                </select>
                                <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label fw-bold text-secondary">رقم الهاتف الشخصي</label>
                                <input asp-for="PhoneNumber" class="form-control form-control-lg border-2" required />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="NationalId" class="form-label fw-bold text-secondary">الرقم القومي</label>
                                <input asp-for="NationalId" class="form-control form-control-lg border-2 font-monospace" required />
                                <span asp-validation-for="NationalId" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Email" class="form-label fw-bold text-secondary">البريد الإلكتروني الرسمي</label>
                                <input asp-for="Email" type="email" class="form-control form-control-lg border-2" required />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold text-secondary"><i class="bi bi-image me-1"></i> تحميل صورة الطبيب الشخصية</label>
                                <input type="file" name="ImageFile" class="form-control form-control-lg border-2" accept="image/*" />
                                @* إظهار الفاليديشن اليدوي من الـ Controller هنا *@
                                @if (!ViewData.ModelState.IsValid && ViewData.ModelState["Biography"] != null)
                                {
                                    <span class="text-danger fw-bold small">@ViewData.ModelState["Biography"].Errors.FirstOrDefault()?.ErrorMessage</span>
                                }
                            </div>
                        </div>

                        <div class="d-flex gap-3 justify-content-end mt-5">
                            <a asp-action="Index" class="btn btn-light btn-lg px-4 fw-bold border">رجوع للقائمة</a>
                            <button type="submit" class="btn btn-info btn-lg px-5 fw-bold text-dark shadow-sm">إدراج الطبيب بالنظام</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>