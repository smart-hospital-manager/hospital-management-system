@model List<SmartHospitalSystem.Service.ViewModels.AppointmentViewModel>

@{
    ViewData["Title"] = "إدارة حجوزات العيادات";
}

<style>
    /* ستايل تذاكر الحجز الطبية المودرن */
    .appointment-ticket-card {
        border: none;
        border-radius: 20px;
        background: #ffffff;
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        overflow: hidden;
    }

        .appointment-ticket-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(217, 131, 36, 0.08) !important;
        }

    .ticket-date-side {
        background-color: rgba(255, 193, 7, 0.08);
        border-right: 2px dashed #ffc107; /* خط مشرط كأنه تذكرة حجز حقيقية */
        min-width: 180px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

    .ticket-avatar-icon {
        width: 45px;
        height: 45px;
        background: #f7fafc;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #718096;
    }
</style>

<div class="container mt-2" dir="rtl">

    <!-- الهيدر الاحترافي الثابت للقسم -->
    <div class="page-header-box d-flex justify-content-between align-items-center mb-4 border-start border-warning border-4 bg-white p-4 rounded-4 shadow-sm animate__animated animate__fadeIn">
        <div>
            <h3 class="text-dark fw-bold mb-1"><i class="bi bi-calendar-check-fill text-warning me-2"></i> مواعيد الحجوزات الطبية</h3>
            <p class="text-muted mb-0 small">جدولة ومتابعة تذاكر الكشف الحالية وتوزيع الحالات على عيادات الأطباء</p>
        </div>
        <a asp-action="Create" class="btn btn-warning fw-bold text-dark px-4 py-2 rounded-3 shadow-sm d-flex align-items-center">
            <i class="bi bi-calendar-plus-fill me-1 fs-5"></i> حجز موعد طبي جديد
        </a>
    </div>

    <!-- شبكة التذاكر (Grid Layout) -->
    <div class="row g-4 animate__animated animate__fadeInUp">
        @if (Model != null && Model.Any())
        {
            foreach (var app in Model)
            {
                <div class="col-lg-6">
                    <div class="card appointment-ticket-card shadow-sm h-100">
                        <div class="d-flex flex-column flex-sm-row h-100">

                            <!-- 📄 الجزء الأيمن: بيانات المريض والطبيب والعيادة -->
                            <div class="card-body p-4 flex-grow-1">
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <span class="text-muted small fw-bold">كود الحجز: #@app.Id</span>
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary px-3 py-1 rounded-pill fw-bold">
                                        <i class="bi bi-building me-1"></i> @app.DepartmentName
                                    </span>
                                </div>

                                <!-- اسم المريض -->
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    <div class="ticket-avatar-icon text-primary bg-primary bg-opacity-10"><i class="bi bi-person-fill"></i></div>
                                    <div>
                                        <small class="text-muted d-block font-11">المريض المحجوز له</small>
                                        <h6 class="fw-bold text-dark m-0">@app.PatientFullName</h6>
                                    </div>
                                </div>

                                <!-- اسم الدكتور -->
                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <div class="ticket-avatar-icon text-success bg-success bg-opacity-10"><i class="bi bi-heart-pulse-fill"></i></div>
                                    <div>
                                        <small class="text-muted d-block font-11">الطبيب المشرف</small>
                                        <h6 class="fw-bold text-success m-0">د. @app.DoctorFullName</h6>
                                    </div>
                                </div>

                                <!-- سبب الزيارة -->
                                <div class="bg-light p-2 rounded-3 small text-muted">
                                    <i class="bi bi-chat-right-text-fill text-secondary me-1"></i> <strong>الشكوى المبدئية:</strong> @app.ReasonForVisit
                                </div>
                            </div>

                            <!-- ⏳ الجزء الأيسر المشرط: وقت وتاريخ الحجز -->
                            <div class="ticket-date-side p-4 text-center">
                                <i class="bi bi-clock-fill text-warning display-6 mb-2"></i>
                                <span class="fw-bold text-dark fs-5">@app.AppointmentDate.ToString("yyyy-MM-dd")</span>
                                <span class="text-muted font-monospace small mt-1 bg-white px-3 py-1 rounded-pill shadow-sm">
                                    @app.AppointmentDate.ToString("hh:mm tt")
                                </span>
                            </div>

                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <!-- رسالة منسقة في حال خلو الجدول -->
            <div class="col-12 text-center py-5">
                <div class="bg-white p-5 rounded-4 shadow-sm d-inline-block w-100">
                    <i class="bi bi-calendar-x text-muted display-1"></i>
                    <h4 class="fw-bold text-secondary mt-3">لا توجد حجوزات مسجلة اليوم</h4>
                    <p class="text-muted small">يمكنك البدء بحجز أول موعد طبي بالضغط على زر الحجز بالأعلى.</p>
                </div>
            </div>
        }
    </div>

</div>