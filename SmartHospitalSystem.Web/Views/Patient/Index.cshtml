@model List<SmartHospitalSystem.Service.ViewModels.PatientViewModel>

@{
    ViewData["Title"] = "سجل المرضى الرقمي";
}

<style>
    .patient-list-card {
        border: none;
        border-radius: 16px;
        background: #ffffff;
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        border-right: 4px solid #cbd5e0;
    }

        .patient-list-card:hover {
            transform: scale(1.01);
            box-shadow: 0 10px 25px rgba(13, 110, 253, 0.05) !important;
            border-right-color: #0d6efd;
        }

    .patient-icon-avatar {
        width: 50px;
        height: 50px;
        background-color: rgba(13, 110, 253, 0.08);
        color: #0d6efd;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .blood-badge {
        background-color: rgba(220, 53, 69, 0.1);
        color: #dc3545;
        font-weight: 700;
        padding: 0.4rem 1rem;
        border-radius: 50px;
        font-size: 0.85rem;
    }
</style>

<div class="container mt-2" dir="rtl">
    <div class="page-header-box d-flex justify-content-between align-items-center mb-4 border-start border-primary border-4 bg-white p-4 rounded-4 shadow-sm">
        <div>
            <h3 class="text-dark fw-bold mb-1"><i class="bi bi-people-fill text-primary me-2"></i> سجلات المرضى الرقمية</h3>
            <p class="text-muted mb-0 small">إدارة وتصفح الملفات الشخصية للمرضى</p>
        </div>
        <a asp-action="Create" class="btn btn-primary fw-bold px-4 py-2 rounded-3 shadow-sm"><i class="bi bi-person-plus-fill me-1"></i> تسجيل مريض جديد</a>
    </div>

    <div class="d-flex flex-column gap-3">
        @if (Model != null)
        {
            foreach (var p in Model)
            {
                <div class="card patient-list-card shadow-sm p-3">
                    <div class="card-body p-0 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="patient-icon-avatar shadow-sm"><i class="bi bi-person-fill fs-4"></i></div>
                            <div>
                                <h5 class="fw-bold text-dark mb-1">@p.FirstName @p.LastName</h5>
                                <span class="text-muted small font-monospace">الرقم القومي: @p.NationalId</span>
                            </div>
                        </div>
                        <div class="d-flex flex-wrap align-items-center gap-md-5 gap-3 small">
                            <div><span class="text-muted d-block mb-1">رقم الهاتف</span><span class="text-dark fw-bold">@p.PhoneNumber</span></div>
                            <div><span class="text-muted d-block mb-1">العنوان</span><span class="text-secondary">@p.Address</span></div>
                        </div>
                        <div class="d-flex align-items-center justify-content-between justify-content-md-end gap-3">
                            <div class="text-center me-3">
                                <span class="blood-badge shadow-sm"><i class="bi bi-droplet-fill me-1"></i> @p.BloodType</span>
                            </div>
                            <div class="d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-outline-secondary btn-sm rounded-3 px-3 py-2 fw-bold"><i class="bi bi-pencil-square me-1"></i> تعديل</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>