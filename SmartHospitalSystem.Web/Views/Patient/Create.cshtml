@model SmartHospitalSystem.Service.ViewModels.PatientCreateViewModel

@{
    ViewData["Title"] = "تسجيل مريض";
}

<div class="container mt-5 mb-5 animate__animated animate__fadeIn">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="sh-card">
                <div class="p-4 p-md-5">
                    <div class="text-center mb-4">
                        <div class="sh-page-icon mx-auto mb-2" style="width:64px;height:64px;font-size:1.8rem;">
                            <i class="bi bi-person-vcard fs-1"></i>
                        </div>
                        <h3 class="fw-bold text-dark">بطاقة تسجيل مريض جديد</h3>
                        <p class="text-muted">يرجى ملء البيانات الشخصية والطبية بدقة لفتح الملف الطبي</p>
                    </div>

                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label fw-bold text-secondary"><i class="bi bi-person me-1"></i> الاسم الأول</label>
                                <input asp-for="FirstName" class="form-control form-control-lg border-2" placeholder="أدخل الاسم الأول" required />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label fw-bold text-secondary"><i class="bi bi-person me-1"></i> الاسم الأخير</label>
                                <input asp-for="LastName" class="form-control form-control-lg border-2" placeholder="أدخل اسم العائلة" required />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="NationalId" class="form-label fw-bold text-secondary"><i class="bi bi-card-text me-1"></i> الرقم القومي</label>
                                <input asp-for="NationalId" class="form-control form-control-lg border-2 font-monospace" placeholder="14 رقماً" required />
                                <span asp-validation-for="NationalId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="BloodType" class="form-label fw-bold text-secondary"><i class="bi bi-droplet me-1"></i> فصيلة الدم</label>
                                <select asp-for="BloodType" class="form-select form-select-lg border-2" required>
                                    <option value="">اختر الفصيلة...</option>
                                    <option value="A+">A+</option>
                                    <option value="A-">A-</option>
                                    <option value="B+">B+</option>
                                    <option value="B-">B-</option>
                                    <option value="O+">O+</option>
                                    <option value="O-">O-</option>
                                    <option value="AB+">AB+</option>
                                    <option value="AB-">AB-</option>
                                </select>
                                <span asp-validation-for="BloodType" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label fw-bold text-secondary"><i class="bi bi-telephone me-1"></i> رقم الهاتف</label>
                                <input asp-for="PhoneNumber" class="form-control form-control-lg border-2" placeholder="01xxxxxxxxx" required />
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-bold text-secondary"><i class="bi bi-envelope me-1"></i> البريد الإلكتروني</label>
                                <input asp-for="Email" type="email" class="form-control form-control-lg border-2" placeholder="example@mail.com" required />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Address" class="form-label fw-bold text-secondary"><i class="bi bi-geo-alt me-1"></i> العنوان السكني الحالي</label>
                                <input asp-for="Address" class="form-control form-control-lg border-2" placeholder="المحافظة، اسم الشارع، رقم البناية" required />
                                <span asp-validation-for="Address" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-3 justify-content-end mt-5">
                            <a asp-action="Index" class="btn btn-light btn-lg px-4 fw-bold border">إلغاء</a>
                            <button type="submit" class="btn sh-btn-solid btn-lg px-5">حفظ وتأكيد البيانات</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}