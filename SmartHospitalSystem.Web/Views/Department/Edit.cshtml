@model SmartHospitalSystem.Service.ViewModels.DepartmentCreateViewModel

@{
    ViewData["Title"] = "تعديل القسم الطبي";
}

<div class="container mt-4 animate__animated animate__fadeIn" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow border-0 rounded-4">
                <div class="card-body p-5">
                    <div class="text-center mb-5">
                        <div class="bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center rounded-circle p-3 mb-3 shadow-sm">
                            <i class="bi bi-pencil-square fs-1"></i>
                        </div>
                        <h3 class="fw-bold text-dark">تعديل بيانات القسم الطبي</h3>
                        <p class="text-muted">قم بتعديل المسميات أو النطاق العلاجي واضغط على حفظ التغييرات</p>
                    </div>

                    <form asp-action="Edit" method="post">
                        <div class="row g-4">
                            <div class="col-12">
                                <label asp-for="Name" class="form-label fw-bold text-secondary"><i class="bi bi-type me-1"></i> اسم القسم</label>
                                <input asp-for="Name" class="form-control form-control-lg border-2" required />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-bold text-secondary"><i class="bi bi-card-text me-1"></i> نطاق العمل والوصف الطبي</label>
                                <textarea asp-for="Description" class="form-control border-2" rows="4" required></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-3 justify-content-end mt-5">
                            <a asp-action="Index" class="btn btn-light btn-lg px-4 fw-bold border">إلغاء</a>
                            <button type="submit" class="btn btn-primary btn-lg px-5 fw-bold shadow-sm">حفظ التغييرات</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}